generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Canonical merchant brand or group, for example `EDEKA`.
model MerchantBrand {
  id                      String                   @id @default(cuid())
  name                    String
  normalizedName          String                   @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  stores                  MerchantStore[]
  receipts                Receipt[]
  categorySuggestionRules CategorySuggestionRule[]

  @@index([normalizedName, id])
}

/// A specific store belonging to exactly one brand, for example `EDEKA Müller`.
model MerchantStore {
  id                      String                   @id @default(cuid())
  brandId                 String
  brand                   MerchantBrand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name                    String
  normalizedName          String
  street                  String?
  postalCode              String?
  city                    String?
  normalizedAddressKey    String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  receipts                Receipt[]
  categorySuggestionRules CategorySuggestionRule[]

  /// Same-name stores are allowed at different known addresses; two
  /// address-less same-name stores must be disambiguated by display name.
  @@unique([brandId, normalizedName, normalizedAddressKey])
  /// Target of the compound receipt relation that keeps store and brand consistent.
  @@unique([id, brandId])
  @@index([brandId, normalizedName, id])
}

model Receipt {
  id                  String               @id @default(cuid())
  merchantRaw         String
  merchantBrandId     String?
  merchantStoreId     String?
  merchantBrand       MerchantBrand?       @relation(fields: [merchantBrandId], references: [id], onDelete: Restrict)
  merchantStore       MerchantStore?       @relation(fields: [merchantStoreId, merchantBrandId], references: [id, brandId], onDelete: Restrict)
  purchaseDate        String
  purchaseTime        String?
  currency            String               @default("EUR")
  notes               String?
  totalCents          Int
  netCents            Int?
  taxCents            Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lineItems           LineItem[]
  document            ReceiptDocument?
  extractionProposals ExtractionProposal[]

  @@index([purchaseDate, id])
  @@index([merchantBrandId])
  @@index([merchantStoreId])
}

model ReceiptDocument {
  id                          String               @id @default(cuid())
  receiptId                   String               @unique
  receipt                     Receipt              @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  relativePath                String               @unique
  originalFilename            String?
  mediaType                   String
  byteSize                    Int
  sha256                      String
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  normalizationStatus         String               @default("pending")
  normalizationError          String?
  normalizationProfileVersion String?
  normalizationRenderer       String?
  normalizationRequestedAt    DateTime             @default(now())
  normalizationStartedAt      DateTime?
  normalizationCompletedAt    DateTime?
  normalizationRevision       String?
  pages                       ReceiptPage[]
  normalizationJob            NormalizationJob?
  extractionJobs              ExtractionJob[]
  extractionProposals         ExtractionProposal[]

  @@unique([sha256, byteSize])
}

model ReceiptPage {
  id             String          @id @default(cuid())
  documentId     String
  document       ReceiptDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  pageNumber     Int
  totalPages     Int
  relativePath   String          @unique
  mediaType      String
  byteSize       Int
  width          Int
  height         Int
  sha256         String
  profileVersion String
  renderer       String
  createdAt      DateTime        @default(now())

  @@unique([documentId, pageNumber])
}

model NormalizationJob {
  id             String          @id @default(cuid())
  documentId     String          @unique
  document       ReceiptDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status         String          @default("pending")
  profileVersion String
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now())
  claimedAt      DateTime?
  claimToken     String?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, availableAt, id])
}

model ExtractionJob {
  id                          String              @id @default(cuid())
  documentId                  String
  document                    ReceiptDocument     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  normalizationRevision       String
  normalizationProfileVersion String
  extractionProfileVersion    String
  status                      String              @default("pending")
  attempts                    Int                 @default(0)
  maxAttempts                 Int
  availableAt                 DateTime            @default(now())
  claimedAt                   DateTime?
  leaseExpiresAt              DateTime?
  claimToken                  String?
  lastErrorKind               String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  processingAttempts          ExtractionAttempt[]

  @@unique([documentId, normalizationRevision])
  @@index([status, availableAt, id])
  @@index([documentId, createdAt])
}

model ExtractionAttempt {
  id                       String              @id @default(cuid())
  jobId                    String
  job                      ExtractionJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptNumber            Int
  provider                 String
  model                    String
  extractionProfileVersion String
  status                   String              @default("running")
  failureKind              String?
  retryable                Boolean?
  startedAt                DateTime            @default(now())
  completedAt              DateTime?
  durationMs               Int?
  rawProviderOutput        String?
  rawPurgedAt              DateTime?
  validatedOutput          String?
  createdAt                DateTime            @default(now())
  proposal                 ExtractionProposal?

  @@unique([jobId, attemptNumber])
  @@index([completedAt, rawPurgedAt])
}

model ExtractionProposal {
  id                       String               @id @default(cuid())
  receiptId                String
  receipt                  Receipt              @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  documentId               String
  document                 ReceiptDocument      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  attemptId                String               @unique
  attempt                  ExtractionAttempt    @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  normalizationRevision    String
  extractionProfileVersion String
  status                   String               @default("pending")
  snapshot                 String
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  findings                 ExtractionFinding[]
  decisions                ExtractionDecision[]

  @@index([receiptId, createdAt])
  @@index([documentId, normalizationRevision, status])
}

model ExtractionFinding {
  id         String             @id @default(cuid())
  proposalId String
  proposal   ExtractionProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  code       String
  severity   String
  fieldPath  String?
  message    String
  createdAt  DateTime           @default(now())

  @@index([proposalId, severity, code])
}

model ExtractionDecision {
  id                   String             @id @default(cuid())
  proposalId           String
  proposal             ExtractionProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  kind                 String
  actor                String
  proposalSnapshot     String
  acceptedSnapshot     String?
  differences          String?
  acknowledgedWarnings String?
  decidedAt            DateTime           @default(now())

  @@index([proposalId, decidedAt])
}

/// Durable retry record for filesystem cleanup that could not complete after a
/// successful metadata transition. Paths remain internal and storage-relative.
model DocumentFileCleanup {
  id           String   @id @default(cuid())
  relativePath String   @unique
  attempts     Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One node in the user's editable, maximum-two-level spending taxonomy.
model Category {
  id              String                   @id @default(cuid())
  name            String
  normalizedName  String
  parentId        String?
  parent          Category?                @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]               @relation("CategoryHierarchy")
  position        Int
  archivedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  lineItems       LineItem[]
  suggestionRules CategorySuggestionRule[]

  // SQLite expression indexes in the migration enforce sibling uniqueness for
  // both nullable top-level parent IDs and ordinary child parent IDs.
  @@index([parentId, normalizedName])
  @@index([parentId, position, id])
}

/// Transparent exact-description mapping used only to suggest a category.
model CategorySuggestionRule {
  id                    String         @id @default(cuid())
  description           String
  normalizedDescription String
  scopeKind             String
  scopeSpecificity      Int
  scopeIdentity         String
  categoryId            String
  category              Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId               String?
  brand                 MerchantBrand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  storeId               String?
  store                 MerchantStore? @relation(fields: [storeId, brandId], references: [id, brandId], onDelete: Restrict)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([normalizedDescription, scopeKind, scopeIdentity])
  @@index([normalizedDescription, scopeSpecificity, id])
  @@index([categoryId])
  @@index([brandId])
  @@index([storeId])
}

model LineItem {
  id             String    @id @default(cuid())
  receiptId      String
  receipt        Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description    String
  quantityMilli  Int?
  unitPriceCents Int?
  lineTotalCents Int
  kind           String    @default("item")
  position       Int

  @@unique([receiptId, position])
  @@index([receiptId])
  @@index([categoryId])
}
