PORT=3000
HOST=127.0.0.1
DATABASE_URL=file:../../.runtime/development.db
STORAGE_PATH=/tmp/receipt-report-development/documents
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_MAX_IMAGE_WIDTH=20000
DOCUMENT_MAX_IMAGE_HEIGHT=20000
DOCUMENT_MAX_DECODED_PIXELS=200000000
DOCUMENT_MAX_REQUEST_BYTES=27262976
DOCUMENT_VALIDATION_TIMEOUT_MS=5000
NORMALIZATION_MAX_PAGE_PIXELS=16777216
NORMALIZATION_MAX_TOTAL_PIXELS=100000000
NORMALIZATION_TIMEOUT_MS=120000
NORMALIZATION_MEMORY_MB=512
NORMALIZATION_POLL_MS=500
NORMALIZATION_VERIFY_RENDERER=false
WORKER_READY_FILE=../../.runtime/worker.ready
OPERATOR_STALE_AFTER_MS=900000

# Receipt extraction remains local/deterministic until explicitly configured.
EXTRACTION_PROVIDER=fake
EXTRACTION_PROFILE_VERSION=de-receipt-v2
LOG_LEVEL=info
LOG_SENSITIVE_PROVIDER_ERRORS=false
LOG_SLOW_OPERATION_MS=1000
EXTRACTION_TIMEOUT_MS=60000
EXTRACTION_MAX_PAGES=10
EXTRACTION_MAX_IMAGE_BYTES=20971520
EXTRACTION_MAX_RESPONSE_BYTES=1048576
EXTRACTION_POLL_MS=500
EXTRACTION_LEASE_MS=120000
EXTRACTION_MAX_ATTEMPTS=5
EXTRACTION_RETRY_BASE_MS=1000
EXTRACTION_RETRY_MAX_MS=60000
EXTRACTION_RETRY_AFTER_MAX_MS=300000
EXTRACTION_RETRY_JITTER_PERCENT=20
EXTRACTION_RAW_RETENTION_MS=604800000
# For an OpenAI-compatible multimodal provider, also set:
# EXTRACTION_BASE_URL=https://provider.example/v1/
# EXTRACTION_MODEL=provider-model-name
# EXTRACTION_API_KEY=replace-with-a-secret
