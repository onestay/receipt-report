# Pin both images to immutable release tags or, preferably, sha256 digests.
RECEIPT_REPORT_API_IMAGE=receipt-report-api:replace-with-release
RECEIPT_REPORT_WORKER_IMAGE=receipt-report-worker:replace-with-release
RECEIPT_REPORT_DATA_VOLUME=receipt-report-data
RECEIPT_REPORT_PORT=3000
# Optional: point Compose at a differently named, owner-readable secrets file.
# RECEIPT_REPORT_SECRETS_FILE=.env.production
EXTRACTION_PROVIDER=openai-compatible
EXTRACTION_BASE_URL=https://provider.example/v1/
EXTRACTION_MODEL=replace-with-model
EXTRACTION_API_KEY=replace-with-secret
EXTRACTION_PROFILE_VERSION=de-receipt-v2
LOG_LEVEL=info
LOG_SENSITIVE_PROVIDER_ERRORS=false
LOG_SLOW_OPERATION_MS=1000
EMAIL_IMPORT_ENABLED=false
# When enabled, use a dedicated least-privilege mailbox and app password.
# EMAIL_IMPORT_HOST=imap.example.test
# EMAIL_IMPORT_PORT=993
# EMAIL_IMPORT_USERNAME=receipts@example.test
# EMAIL_IMPORT_PASSWORD=replace-with-app-password
# EMAIL_IMPORT_FOLDER=INBOX
